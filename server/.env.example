NODE_ENV=development
PORT=8080
# 从 CloudBase PostgreSQL 的连接配置中取得；不要提交真实值。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# 内网连接通常设为 false；云端按实际连接配置设为 true。
DATABASE_SSL=false
# 使用长度至少 32 字符的随机值；生产环境应保存在云托管环境变量中。
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=em-booking-api
COOKIE_SECURE=false
